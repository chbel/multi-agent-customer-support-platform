# --- LLM ---
GROQ_API_KEY=your_groq_api_key

# --- Checkpointer: "postgres" (default in Docker Compose) or "sqlite" ---
CHECKPOINTER_BACKEND=postgres
DATABASE_PATH=support_checkpoints.db

# Leave DATABASE_URL empty to use the bundled "db" Postgres service in Docker Compose.
# Set it to an external connection string (e.g. Neon) to use a remote database.
# For local runs outside Docker with Compose's db service: postgresql://support:support@localhost:5432/support
DATABASE_URL=

# Credentials for the bundled Postgres service (docker-compose.yml)
POSTGRES_USER=support
POSTGRES_PASSWORD=change_me
POSTGRES_DB=support

LOG_LEVEL=INFO

# --- Authentication ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me

# --- Docker ---
# Your Docker Hub username, used to tag locally built images (defaults to "local")
DOCKERHUB_USERNAME=local
API_PORT=8000
FRONTEND_PORT=8501
